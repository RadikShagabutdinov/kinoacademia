{
  "name": "@kinoacademia/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:run": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.3",
    "@hono/node-ws": "^1.3.0",
    "@hono/zod-openapi": "^1.3.0",
    "@kinoacademia/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.10.11",
    "argon2": "^0.44.0",
    "cron-parser": "^5.5.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.9",
    "hono-rate-limiter": "^0.5.3",
    "jose": "^6.2.3",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@redocly/cli": "^2.30.3",
    "@types/node": "^22.15.3",
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "vitest": "^3.1.3"
  }
}
