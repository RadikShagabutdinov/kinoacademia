PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://kinoacademia:kinoacademia@localhost:5432/kinoacademia

# JWT secrets — обязательны, минимум 32 символа.
# Сгенерировать: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-32+chars-random-secret-replace-with-32
JWT_REFRESH_SECRET=replace-with-another-32+chars-random-secret-here

# Опционально: домен для cookie. Пусто = текущий хост.
COOKIE_DOMAIN=

# URL фронта (для CORS), обязателен.
WEB_ORIGIN=http://localhost:5173

# pino log level: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Запускать ли scheduler плановых задач (cron) внутри API-процесса.
# Отключить (false) при горизонтальном масштабировании, чтобы вынести в отдельный воркер.
JOBS_ENABLED=true

# Дефолтный администратор — создаётся при db:seed, если не существует.
# Оставьте пустыми, чтобы пропустить создание.
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=change-me-before-game

# Хранилище сканов контрактов.
# STORAGE_DRIVER: сейчас поддерживается только 'local' (файлы в SCANS_STORAGE_DIR).
# В будущем — 's3' (Cloudflare R2). SCANS_STORAGE_DIR — путь относительно cwd
# процесса api (по умолчанию ./storage/scans).
STORAGE_DRIVER=local
SCANS_STORAGE_DIR=./storage/scans
