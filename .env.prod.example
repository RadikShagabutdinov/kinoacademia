# Шаблон продакшн-конфигурации. На сервере скопировать в .env.prod и заполнить.
# .env.prod в git не попадает — это единственный носитель секретов на VPS.
# Файл используется дважды: как --env-file для compose (DOMAIN, TAG, POSTGRES_*)
# и как env_file сервиса api (всё остальное).

# --- Домен и TLS (читает Caddy) ---
# Для локальной проверки прод-стека укажите http://localhost — префикс http://
# отключает автоматический выпуск сертификата.
DOMAIN=kinoacademia.example.com
ACME_EMAIL=admin@example.com

# --- Образы ---
IMAGE_API=ghcr.io/OWNER/kinoacademia-api
IMAGE_WEB=ghcr.io/OWNER/kinoacademia-web
TAG=latest

# --- Postgres (сервис postgres в том же compose) ---
POSTGRES_USER=kinoacademia
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=kinoacademia

# --- API ---
NODE_ENV=production
PORT=3000
# Хост postgres — имя сервиса в compose-сети, не localhost.
DATABASE_URL=postgres://kinoacademia:CHANGE-ME@postgres:5432/kinoacademia
DATABASE_POOL_MAX=10

# Обязательны, минимум 32 символа. Сгенерировать: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Должен совпадать с DOMAIN и схемой https — используется для CORS и OpenAPI.
WEB_ORIGIN=https://kinoacademia.example.com
# Пусто = cookie привязана к текущему хосту. Заполнять только для поддоменов.
COOKIE_DOMAIN=

LOG_LEVEL=info
# Планировщик cron-задач внутри процесса api. При нескольких репликах оставить
# true только на одной.
JOBS_ENABLED=true
# Scalar UI на /api/docs. В проде обычно не нужен.
ENABLE_API_DOCS=false

# Накатывать миграции при старте контейнера (читает docker-entrypoint.sh).
RUN_MIGRATIONS=true

# --- Первичный сид (docker compose run --rm api node dist/seed.js) ---
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=CHANGE-ME
# Тестовые игроки vamp/wolf — на проде не создавать.
SEED_DEFAULT_PLAYERS=false

# --- Хранилище сканов (том scans-data) ---
STORAGE_DRIVER=local
SCANS_STORAGE_DIR=/data/scans
